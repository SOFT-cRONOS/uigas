{
  "name": "uigas",
  "version": "1.0.0",
  "private": true,
  "description": "UiGas — CSS framework (Bootstrap 5 override) · Dark Sport Minimal · Brandbook CVR 2027",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "bootstrap": "^5.3.0"
  },
  "scripts": {
    "build": "sass src/scss/style.scss dist/uigas.min.css --style=compressed --no-source-map && node tools/build-js.mjs",
    "build:dev": "sass src/scss/style.scss dist/uigas.css --style=expanded --no-source-map && node tools/build-js.mjs",
    "build:js": "node tools/build-js.mjs",
    "watch": "sass --watch src/scss/style.scss dist/uigas.min.css --style=compressed --no-source-map",
    "docs": "node tools/docs/build.mjs",
    "docs:check": "node tools/docs/check-links.mjs",
    "docs:watch": "node --watch-path=tools/docs node tools/docs/build.mjs"
  },
  "devDependencies": {
    "sass": "^1.77.0"
  }
}
